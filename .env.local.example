# Copy this file to .env.local and fill in your values

# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — get from resend.com dashboard
RESEND_API_KEY=re_your_key

# Your app's URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email sender address (must be verified in Resend)
RESEND_FROM_EMAIL=BizHaus <noreply@yourdomain.com>
